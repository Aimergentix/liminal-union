#. [alignment]: id=LIUN_liminal
#: liminal-union/macros/alignment.cfg:5
msgid "liminal"
msgstr "liminal"

#. [alignment]: id=LIUN_liminal
#: liminal-union/macros/alignment.cfg:6
msgid "Liminal units are at their most effective during the transition turns of Dawn and Dusk (+25%). The Liminal Union's unique engineering reduces the midday penalty to -15%."
msgstr "Liminale Einheiten kämpfen in den Übergangsphasen von Morgen- und Abenddämmerung am wirkungsvollsten (+25%). Die besondere Handwerkskunst der Liminalen Union mildert den Mittagsabzug auf -15%."

#. [alignment]: id=LIUN_liminal_conducted
#: liminal-union/macros/alignment.cfg:46
msgid "liminal (conducted)"
msgstr "liminal (konduktiert)"

#. [alignment]: id=LIUN_liminal_conducted
#: liminal-union/macros/alignment.cfg:47
msgid "This unit's alignment is being stabilized by a nearby Conductor. Peak power is maintained, and Day and Night penalties are softened by +10%."
msgstr "Die Gesinnung dieser Einheit wird durch einen nahen Konduktor stabilisiert. Die volle Dämmerungsstärke bleibt erhalten und die Abzüge bei Tag und Nacht werden um +10% gemildert."

