msgstr ""

#. [unit_type]: id=LIUN_Initiate, gender=male,female, race=human
#: liminal-union/units/nations/loyalist/mf0-initiate.cfg:4
msgid "Initiate"
msgstr ""

#. [unit_type]: id=LIUN_Initiate, gender=male,female, race=human
#: liminal-union/units/nations/loyalist/mf0-initiate.cfg:19
msgid "Only few individuals of the human race are capable of manipulating magic, and even fewer are recognized and trained as mages. Fresh initiates may feel intimidated by the studies still ahead of them, but these are unremarkable in comparison to what they already achieved. Physically frail, and lacking familiarity with combat, initiates do possess certain arts which are of great utility in battle."
msgstr ""

#. [attack]: type=fire
#: liminal-union/units/nations/loyalist/mf0-initiate.cfg:33
