#: liminal-union/units/nations/dunefolk/sc2-hashishine.cfg:50
msgid "kick & punch"
msgstr ""

#. [attack]: type=blade
#: liminal-union/units/nations/dunefolk/sc2-hashishine.cfg:59
msgid "hashishi attack"
msgstr ""

