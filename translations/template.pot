msgstr ""

#. [unit_type]: id=LIUN_Squire, race=human
#: liminal-union/units/nations/loyalist/sc0-horse-squire.cfg:4
msgid "Squire"
msgstr ""

#. [unit_type]: id=LIUN_Squire, race=human
#: liminal-union/units/nations/loyalist/sc0-horse-squire.cfg:19
msgid "Squires are apprentices to knights, who often hail from either wealthy families or the eastern horse clans. They practise fighting with a wooden lance, but have yet to master the fearsome charges of their mentors."
msgstr ""

#. [attack]: type=pierce
#: liminal-union/units/nations/loyalist/sc0-horse-squire.cfg:23
