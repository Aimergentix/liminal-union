msgid "Trolling"
msgstr ""

#. [unit_type]: id=LIUN_Trolling
#: liminal-union/units/nations/northerners/p0-trolling.cfg:25
msgid "A trolling is a very young Troll."
msgstr ""

#. [unit_type]: id=LIUN_Wolfling, race=wolf
#: liminal-union/units/nations/northerners/p0-wolfling.cfg:4
msgid "Wolfling"
msgstr ""

#. [unit_type]: id=LIUN_Wolfling, race=wolf
#: liminal-union/units/nations/northerners/p0-wolfling.cfg:33
msgid "Wolfings are young wolves that are raised by goblins. Goblin even use them in fights."
msgstr ""

#. [attack]: type=blade
#: liminal-union/units/nations/northerners/p0-wolfling.cfg:47
msgid "fangs"
msgstr ""

#. [unit_type]: id=LIUN_Merman_Citizen, race=merman
#: liminal-union/units/nations/rebels/f0-merman-citizen.cfg:4
msgid "Merman Citizen"
msgstr ""

#. [unit_type]: id=LIUN_Merman_Citizen, race=merman
#: liminal-union/units/nations/rebels/f0-merman-citizen.cfg:18
msgid "Merfolk are mostly peaceful, but will fight to defend their homes. In this situation, even merfolk with no weapons or training can be dangerous."
msgstr ""

#. [unit_type]: id=LIUN_Wose_Sapling, race=wose
#: liminal-union/units/nations/rebels/f0-wose-sapling.cfg:4
msgid "Wose Sapling"
msgstr ""

#. [unit_type]: id=LIUN_Wose_Sapling, race=wose
#: liminal-union/units/nations/rebels/f0-wose-sapling.cfg:18
msgid "Rarely seen even by elves, the Wose is an order of creature about which little is known. The elves are the source of most of this knowledge; they know that these beings are not descended from trees, despite the similarity in form, and they know that a wose is more closely tied to the faerie world than the elves themselves, though in a different way. The motives and workings of their kind are unknown, though most subscribe to the obvious theory that woses are dedicated wardens of the natural world. Woses are utterly unwarlike, but possess a great strength. They are, however, neither used to, nor quick at moving around."
msgstr ""

#. [attack]: type=impact
#: liminal-union/units/nations/rebels/f0-wose-sapling.cfg:28
msgid "crush"
msgstr ""

#. [unit_type]: id=LIUN_Elvish_Healer, race=elf, gender=female
#: liminal-union/units/nations/rebels/h0-elvish-healer.cfg:4
msgid "female^Elvish Healer"
msgstr ""

#. [unit_type]: id=LIUN_Elvish_Healer, race=elf, gender=female
#: liminal-union/units/nations/rebels/h0-elvish-healer.cfg:19
msgid "Some elves are unusually close to their faerie nature, which enables them to control magic consciously. On the battlefield, they use their skills to heal wounds and summon plants to their aid."
msgstr ""

#. [attack]: type=impact
#: liminal-union/units/nations/rebels/h0-elvish-healer.cfg:36
msgid "entangle"
msgstr ""

#. [unit_type]: id=LIUN_Elvish_Citizen, race=elf, gender=male,female
#: liminal-union/units/nations/rebels/mf0-elvish-citizen.cfg:4
msgid "Elvish Citizen"
msgstr ""

#. [unit_type]: id=LIUN_Elvish_Citizen, race=elf, gender=male,female
#: liminal-union/units/nations/rebels/mf0-elvish-citizen.cfg:20
msgid "Although elves are not warlike by nature their natural grace ensures that even untrained they have talent for swords and bows. However, if you are hurling citizens at your foes, you’re clearly out of superior forces."
msgstr ""

#. [attack]: type=blade
#: liminal-union/units/nations/rebels/mf0-elvish-citizen.cfg:28
#: liminal-union/units/nations/rebels/sc0-elvish-horseman.cfg:34
msgid "sword"
msgstr ""

#. [attack]: type=pierce
#: liminal-union/units/nations/rebels/mf0-elvish-citizen.cfg:38
#: liminal-union/units/nations/rebels/sc0-elvish-horseman.cfg:43
msgid "bow"
msgstr ""

#. [female]: gender=female
#: liminal-union/units/nations/rebels/mf0-elvish-citizen.cfg:87
msgid "female^Elvish Citizen"
msgstr ""

#. [unit_type]: id=LIUN_Elvish_Horseman, race=elf
#: liminal-union/units/nations/rebels/sc0-elvish-horseman.cfg:4
msgid "Elvish Horseman"
msgstr ""

#. [unit_type]: id=LIUN_Elvish_Horseman, race=elf
#: liminal-union/units/nations/rebels/sc0-elvish-horseman.cfg:22
msgid "The true skill of elvish horsemen skill lies in their ability to dart through the thick of the forest with nary a scratch. Though only lightly armed, they are the only cavalry in existence that fares better in the woods than on open ground."
msgstr ""

#. [unit_type]: id=LIUN_Dark_Initiate, gender=male,female, race=human
#: liminal-union/units/nations/undead/a0-dark-initiate.cfg:4
msgid "Dark Initiate"
msgstr ""

#. [unit_type]: id=LIUN_Dark_Initiate, gender=male,female, race=human
#: liminal-union/units/nations/undead/a0-dark-initiate.cfg:23
msgid "Curiosity is the mother of scholarship and thus the highest virtue of the order of magi. However, not all students find the golden mean, and some succumb to the temptation of practising the dark arts at night. The resulting lack of sleep exhausts them so much, that they become even weaker than lawful initiates."
msgstr ""

#. [attack]: type=cold
#: liminal-union/units/nations/undead/a0-dark-initiate.cfg:28
msgid "chill wave"
msgstr ""

#. [attack]: type=arcane
#: liminal-union/units/nations/undead/a0-dark-initiate.cfg:40
msgid "shadow wave"
msgstr ""

#. [female]: gender=female
#: liminal-union/units/nations/undead/a0-dark-initiate.cfg:78
msgid "female^Dark Initiate"
msgstr ""

#. [unit_type]: id=LIUN_Walking_Skeleton, race=undead
#: liminal-union/units/nations/undead/f0-walking-skeleton.cfg:4
msgid "Walking Skeleton"
msgstr ""

#. [unit_type]: id=LIUN_Walking_Skeleton, race=undead
#: liminal-union/units/nations/undead/f0-walking-skeleton.cfg:22
msgid "With enough experience, a necromancer becomes independent from freshly killed corpses. Fully rotten skeletons are not only excellent war material, but are also far easier to attain."
msgstr ""

#. [unit_type]: id=LIUN_Ghouling
#: liminal-union/units/nations/undead/sc0-ghouling.cfg:7
msgid "Ghouling"
msgstr ""

#. [unit_type]: id=LIUN_Ghouling
#: liminal-union/units/nations/undead/sc0-ghouling.cfg:16
msgid "A ghouling is a small Ghoul."
msgstr ""

#. [unit_type]: id=LIUN_Soul, race=undead
#: liminal-union/units/nations/undead/sc0-soul.cfg:4
msgid "Soul"
msgstr ""

#. [unit_type]: id=LIUN_Soul, race=undead
#: liminal-union/units/nations/undead/sc0-soul.cfg:18
msgid "Some souls cannot find rest and are damned to aimlessly wander this world for eternity. Often they belong to inexperienced Dark Adepts, who tried to cheat their premature death. And succeeded. Regrettably."
msgstr ""

#. [attack]: type=arcane
#: liminal-union/units/nations/undead/sc0-soul.cfg:64
